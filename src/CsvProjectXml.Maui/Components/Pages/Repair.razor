@page "/repair/{SessionId:guid}"
@inject RepairSessionStore Sessions
@inject CsvRepairService RepairService
@inject CsvProjectConverter Converter
@inject NavigationManager Navigation
@inject ConversionPageState ConversionPage
@inject ConversionReportWriter ReportWriter

<PageTitle>مراجعة تعارضات CSV</PageTitle>

@if (Session is null)
{
    <div class="page-heading">
        <div>
            <div class="eyebrow">CSV REPAIR</div>
            <h1>جلسة الإصلاح غير موجودة</h1>
            <p>قد تكون انتهت جلسة الإصلاح عند إغلاق التطبيق أو إعادة تشغيله.</p>
        </div>
    </div>
    <button class="btn btn-primary" @onclick="BackToConversion">العودة للتحويل</button>
}
else if (Result is not null)
{
    <div class="page-heading">
        <div>
            <div class="eyebrow">CONVERSION COMPLETED</div>
            <h1>تم إصلاح البيانات وتحويل المشروع بنجاح</h1>
            <p>@Session.CurrentRequest.Department.DisplayName</p>
        </div>
        <div class="status-pill"><span></span> اكتمل التحويل</div>
    </div>
    <div class="result-banner success">
        <div class="result-banner-icon">✓</div>
        <div><strong>تم إنشاء ملفات XML</strong><p>@Result.RowCount.ToString("N0") صف · @Result.FilmCount فيلم · @Result.FieldCount حقل</p></div>
    </div>
    <ResultFiles Files="Result.Files" OutputDirectory="Result.OutputDirectory" />
    <div class="form-actions"><button class="btn btn-primary" @onclick="BackToConversion">العودة إلى التحويل</button></div>
}
else
{
    <div class="page-heading">
        <div>
            <div class="eyebrow">MANUAL CONFLICT RESOLUTION</div>
            <h1>مراجعة تعارضات البيانات</h1>
            <p>@Session.CurrentRequest.Department.DisplayName</p>
            <p class="repair-source">الملف الأصلي: <span dir="ltr">@Session.OriginalDataCsvPath</span></p>
        </div>
        <div class="status-pill warning-pill">@Rows.Count تعارض</div>
    </div>

    <div class="repair-safety-note">
        <strong>لن يتم تعديل الملف الأصلي.</strong>
        <span>سيتم حفظ نسخة CSV مصححة في مجلد مستقل، ثم إعادة فحصها قبل إنشاء ملفات XML.</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-error"><strong>تعذر حفظ التصحيحات</strong><div>@ErrorMessage</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(InfoMessage))
    {
        <div class="alert alert-info"><strong>إعادة الفحص</strong><div>@InfoMessage</div></div>
    }

    @foreach (var row in Rows)
    {
        <section class="panel repair-row-card">
            <div class="repair-row-heading">
                <div>
                    <span class="panel-step">سجل البيانات @row.RecordNumber</span>
                    <h2>سطر الملف @row.StartLine</h2>
                </div>
                <span class="state-tag state-danger">@row.Issues.Count مشكلة</span>
            </div>
            <div class="repair-issues">
                @foreach (var issue in row.Issues)
                {
                    <div class="repair-issue"><strong>@issue.Code</strong><span>@issue.Message</span></div>
                }
            </div>
            <div class="repair-cells">
                @for (var index = 0; index < row.Cells.Count; index++)
                {
                    var cellIndex = index;
                    var headerName = cellIndex < Session.ExpectedHeaders.Count
                        ? Session.ExpectedHeaders[cellIndex]
                        : $"عمود إضافي #{cellIndex + 1}";
                    <div class="repair-cell">
                        <div class="repair-cell-label"><label>@headerName</label><small>العمود @(cellIndex + 1)</small></div>
                        <textarea rows="2" dir="auto" class="text-input repair-cell-input" @bind="row.Cells[cellIndex]"></textarea>
                        <div class="repair-cell-actions">
                            @if (cellIndex < row.Cells.Count - 1)
                            {
                                <button type="button" class="btn btn-small btn-outline" @onclick="() => MergeWithNext(row, cellIndex)">دمج مع العمود التالي</button>
                            }
                            <button type="button" class="btn btn-small btn-outline" @onclick="() => InsertCell(row, cellIndex + 1)">إدراج عمود بعده</button>
                            <button type="button" class="btn btn-small btn-ghost" @onclick="() => RemoveCell(row, cellIndex)">حذف العمود</button>
                        </div>
                    </div>
                }
            </div>
            <button type="button" class="btn btn-small btn-outline" @onclick="() => AddCell(row)">+ إضافة عمود فارغ</button>
        </section>
    }

    <div class="repair-submit-bar">
        <div><strong>@Rows.Count سجل بحاجة إلى مراجعة</strong><span>راجع عدد الأعمدة والقيم قبل إعادة الفحص.</span></div>
        <button class="btn btn-primary run-button" disabled="@IsSaving" @onclick="SaveAndRetry">
            @if (IsSaving) { <span class="spinner"></span><span>جارٍ الحفظ وإعادة الفحص...</span> }
            else { <span>حفظ التصحيحات وإعادة التحويل</span> }
        </button>
    </div>
}

@code {
    [Parameter] public Guid SessionId { get; set; }

    private PendingRepairSession? Session { get; set; }
    private List<EditableConflictRow> Rows { get; set; } = [];
    private DepartmentConversionResult? Result { get; set; }
    private bool IsSaving { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private string InfoMessage { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (!Sessions.TryGet(SessionId, out var session))
        {
            Session = null;
            Rows = [];
            return;
        }

        Session = session;
        Rows = session.Conflicts.Select(conflict => new EditableConflictRow(
            conflict.RecordNumber, conflict.StartLine, conflict.Cells.ToList(), conflict.Issues)).ToList();
    }

    private void MergeWithNext(EditableConflictRow row, int index)
    {
        if (index < 0 || index >= row.Cells.Count - 1) return;
        // Preserve the exact comma and surrounding spaces that were split by the CSV parser.
        row.Cells[index] += "," + row.Cells[index + 1];
        row.Cells.RemoveAt(index + 1);
    }

    private void RemoveCell(EditableConflictRow row, int index)
    {
        if (row.Cells.Count <= 1 || index < 0 || index >= row.Cells.Count) return;
        row.Cells.RemoveAt(index);
    }

    private static void AddCell(EditableConflictRow row) => row.Cells.Add(string.Empty);

    private static void InsertCell(EditableConflictRow row, int index)
    {
        if (index < 0 || index > row.Cells.Count) return;
        row.Cells.Insert(index, string.Empty);
    }

    private async Task SaveAndRetry()
    {
        var session = Session;
        if (session is null || IsSaving) return;
        ErrorMessage = string.Empty;
        InfoMessage = string.Empty;
        IsSaving = true;
        try
        {
            var corrections = Rows.ToDictionary(
                row => row.RecordNumber,
                row => (IReadOnlyList<string>)row.Cells.ToArray());

            var repairDirectory = Path.Combine(session.CurrentRequest.OutputRoot, "_repaired-inputs",
                session.CurrentRequest.Department.Value, session.Id.ToString("N"));
            Directory.CreateDirectory(repairDirectory);
            var revision = session.Revision + 1;
            var correctedPath = Path.Combine(repairDirectory, $"data-revision-{revision}.csv");
            RepairService.WriteCorrectedCopy(session.CurrentRequest.DataCsvPath, correctedPath, corrections);

            var correctedRequest = session.CurrentRequest with { DataCsvPath = correctedPath };
            var preflight = await Task.Run(() => Converter.Validate(correctedRequest, session.Settings));
            if (preflight.HasConflicts)
            {
                var updatedSession = session with
                {
                    CurrentRequest = correctedRequest,
                    ExpectedHeaders = ReadExpectedHeaders(correctedRequest.DataCsvPath),
                    Conflicts = preflight.Conflicts,
                    Revision = revision
                };
                Session = updatedSession;
                Sessions.Update(updatedSession);
                Rows = updatedSession.Conflicts.Select(conflict => new EditableConflictRow(
                    conflict.RecordNumber, conflict.StartLine, conflict.Cells.ToList(), conflict.Issues)).ToList();
                InfoMessage = $"تم حفظ نسخة التصحيح، لكن ما زال هناك {Rows.Count} سجل يحتاج إلى مراجعة. أصلح التعارضات المتبقية ثم أعد المحاولة.";
                return;
            }

            Result = await Task.Run(() => Converter.Convert(correctedRequest, session.Settings));
            UpdateConversionPageAfterRepair(session, Result);
            Sessions.Remove(session.Id);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex is ConversionException conversion ? conversion.ToString() : ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }


    private void UpdateConversionPageAfterRepair(PendingRepairSession session, DepartmentConversionResult result)
    {
        var page = ConversionPage.Current;
        if (page is null) return;

        // Single-project flow: restore the successful result on the conversion page.
        if (page.PendingRepairSessionId == session.Id)
        {
            ConversionPage.Save(page with
            {
                SingleResult = result,
                PendingRepairSessionId = null,
                ErrorMessage = string.Empty,
                ReportPath = string.Empty
            });

            try
            {
                var reportPath = ReportWriter.SaveSingle(
                    session.CurrentRequest.OutputRoot,
                    result,
                    session.CurrentRequest.FieldsCsvPath,
                    session.OriginalDataCsvPath);
                if (ConversionPage.Current is { } current)
                    ConversionPage.Save(current with { ReportPath = reportPath });
            }
            catch
            {
                // XML conversion has already succeeded. A report-file failure must not
                // discard the result or make the user repeat the conversion.
            }

            return;
        }

        // Batch flow: replace only the repaired department's failed item.
        if (page.BatchResult is not { } batch) return;
        var found = batch.Departments.Any(item => item.RepairSessionId == session.Id);
        if (!found) return;

        var updatedDepartments = batch.Departments.Select(item => item.RepairSessionId == session.Id
            ? item with
            {
                Status = DepartmentBatchStatus.Converted,
                Result = result,
                Message = null,
                Conflicts = null,
                RepairSessionId = null
            }
            : item).ToArray();
        var updatedBatch = batch with { Departments = updatedDepartments };

        ConversionPage.Save(page with
        {
            BatchResult = updatedBatch,
            ErrorMessage = string.Empty,
            ReportPath = string.Empty
        });

        try
        {
            var reportPath = ReportWriter.SaveBatch(session.CurrentRequest.OutputRoot, updatedBatch);
            if (ConversionPage.Current is { } current)
                ConversionPage.Save(current with { ReportPath = reportPath });
        }
        catch
        {
            // Preserve the updated batch results even if saving the optional report fails.
        }
    }

    private static IReadOnlyList<string> ReadExpectedHeaders(string dataCsvPath)
    {
        using var enumerator = CsvReader.Read(dataCsvPath).GetEnumerator();
        return enumerator.MoveNext() ? enumerator.Current.Values.ToArray() : [];
    }

    private void BackToConversion() => Navigation.NavigateTo("/convert");

    private sealed record EditableConflictRow(
        long RecordNumber,
        int StartLine,
        List<string> Cells,
        IReadOnlyList<RowValidationIssue> Issues);
}
